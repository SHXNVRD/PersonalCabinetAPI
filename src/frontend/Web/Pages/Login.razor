@page "/auth/login"
@using System.ComponentModel.DataAnnotations
@using System.Text.RegularExpressions
@using FluentResults
@using Web.Services.Authentication
@using Web.Services.Authentication.DTOs
@attribute [AllowAnonymous]
@layout EmptyLayout

<PageTitle>Вход - Dotneft Admin</PageTitle>

<MudGrid Justify="Justify.Center"
         Style="margin-top: 200px">
    <MudItem xs="12"
             md="12">
        <MudText Align="Align.Center"
                 Typo="Typo.h2"
                 GutterBottom>
            <b>Вход</b>
        </MudText>
    </MudItem>
    
    <MudItem md="3"
             xs="6">
        <EditForm FormName="login"
                  Model="Input"
                  OnValidSubmit="LoginUserAsync">
                  <DataAnnotationsValidator/>
                  <MudGrid>
                      <MudItem md="12"
                               xs="12">
                          <MudTextField @bind-Value="Input.Login"
                                        Variant="Variant.Filled"
                                        For="@(() => Input.Login)"
                                        Label="Логин"
                                        Placeholder="Электронная почта или никнейм"
                                        UserAttributes="@(new Dictionary<string, object?> { { "autocomplete", "true" }, { "aria-required", "true" } })"/>
                      </MudItem>
                      
                      <MudItem md="12"
                               xs="12">
                          <MudTextField @bind-Value="Input.Password"
                                        For="@(() => Input.Password)"
                                        Variant="Variant.Filled"
                                        Label="Пароль"
                                        Placeholder="Введите свой пароль"
                                        Adornment="Adornment.End"
                                        InputType="@_passwordInputType"
                                        AdornmentIcon="@_passwordInputIcon"
                                        AdornmentAriaLabel="Show Password"
                                        OnAdornmentClick="ShowPassword"
                                        Style="pointer-events: all"
                                        UserAttributes="@(new Dictionary<string, object?> { { "autocomplete", "true" }, { "aria-required", "true" } })">
                          </MudTextField>
                      </MudItem>
                      
                      <MudItem md="12"
                               xs="12">
                          <MudButton ButtonType="ButtonType.Submit"
                                     Color="Color.Primary"
                                     FullWidth
                                     Variant="Variant.Filled"
                                     DropShadow="false">
                              Войти
                          </MudButton>
                      </MudItem>
                  </MudGrid>
        </EditForm>
    </MudItem>      
</MudGrid>

@code {
    [SupplyParameterFromForm]
    private LoginModel Input { get; set; } = new();

    [Inject]
    public AuthenticationService AuthenticationService { get; set; } = null!;
    
    [Inject]
    public ISnackbar Snackbar { get; set; } = null!;

    [Inject]
    public NavigationManager Navigation { get; set; } = null!;
    
    private bool _isShowPassword;
    private InputType _passwordInputType = InputType.Password;
    private string _passwordInputIcon = Icons.Material.Filled.VisibilityOff;
    
    protected override void OnParametersSet()
    {
        Input = new LoginModel();
    }

    private void ShowPassword()
    {
        if (_isShowPassword)
        {
            _isShowPassword = false;
            _passwordInputIcon = Icons.Material.Filled.VisibilityOff;
            _passwordInputType = InputType.Password;
        }
        else
        {
            _isShowPassword = true;
            _passwordInputIcon = Icons.Material.Filled.Visibility;
            _passwordInputType = InputType.Text;
        }
    }

    private async Task LoginUserAsync()
    {
        var result = await AuthenticationService.LoginAsync(Input.Password, Input.Login);
        if (result.IsFailed)
            Snackbar.Add($"Не удалось авторизоваться. {result.Errors.FirstOrDefault()}", Severity.Error);
        else
            Navigation.NavigateTo("");
    }
    
    private sealed class LoginModel
    {
        [Required(ErrorMessage = "Логин обязателен")]
        [Display(Name = "Никнейм или Email")]
        public string Login { get; set; } = string.Empty;

        [Required(ErrorMessage = "Пароль обязателен")]
        [DataType(DataType.Password)]
        [Display(Name = "Пароль")]
        public string Password { get; set; } = string.Empty;
    }
}