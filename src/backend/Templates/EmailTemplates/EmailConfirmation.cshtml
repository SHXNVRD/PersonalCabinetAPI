@using Templates.EmailTemplates
@model Templates.EmailTemplates.EmailConfirmationViewModel
@{ Layout = "_Layout.cshtml";}

<div>
    <h2 style="font-size: 24px; font-weight: 700;">Подтверждение почты</h2>
    <br>
    <p>
        Здравствуйте, для подтверждения адреса электронной почты, нажмите на кнопку ниже.
    </p>
    <div style="text-align: center; margin: 30px 0">
        @await Html.PartialAsync("Button.cshtml", new ButtonViewModel("Подтвердить почту", @Model.ConfirmationLink))
    </div>
    <p>
        Если Вы не создавали учётную запись в нашей системе, игнорируйте это письмо.
    </p>
    <br>
    <p>
        С уважением,
    </p>
    <p>
        Company name Team.
    </p>
</div>
