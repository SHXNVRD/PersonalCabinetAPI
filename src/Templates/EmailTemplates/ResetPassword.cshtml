@using Templates.EmailTemplates
@model Templates.EmailTemplates.ResetPasswordViewModel
@{ Layout = "_Layout.cshtml";}

<div>
    <h2 style="font-size: 24px; font-weight: 700;">Сброс пароля</h2>
    <br>
    <p>
        Здравствуйте, для сброса пароля, пожалуйста, нажмите на кнопку ниже.</p>
    <div style="text-align: center; margin: 30px 0">
        @await Html.PartialAsync("Button.cshtml", new ButtonViewModel("Сбросить пароль", @Model.ResetLink));
    </div>
    <p>
        Если Вы не запрашивали сброс пароля от своей учётной записи, пожалуйста, игнорируйте это письмо.
    </p>
    <br>
    <p>
        С уважением,
    </p>
    <p>
        Company name Team.
    </p>
</div>